####################################################################################
####                                                                            ####
####                           Hyderabad  (ap-south-2)                            ####
####                                                                            ####
####################################################################################

provider "aws" {
  region                   = "ap-south-2"
}

####################################################################################
####                                                                            ####
####                           Infra state file	                                ####
####                                                                            ####
####################################################################################

terraform {
  backend "s3" {
    bucket                  = "yesbank-infra-preprod-tf-state"
    key                     = "infra/infra.tfstate"
    region                  = "ap-south-2"
  }
}


####################################################################################
####                                                                            ####
####                           Network state file	                              ####
####                                                                            ####
####################################################################################

data "terraform_remote_state" "networking_state" {
  backend = "s3"
  config = {
    bucket = "yesbank-network-preprod-tf-state"
    key    = "network/network.tfstate"
    region = "ap-south-2"
  }
}
