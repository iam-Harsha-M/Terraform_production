####################################################################################
####                                                                            ####
####                           Hyderabad  (ap-south-2)                            ####
####                                                                            ####
####################################################################################

provider "aws" {
  region                   = "ap-south-2"
}

####################################################################################
####                                                                            ####
####                           Network state file	                        ####
####                                                                            ####
####################################################################################

terraform {
  backend "s3" {
    bucket                  = "yesbank-network-preprod-tf-state"
    key                     = "network/network.tfstate"
    region                  = "ap-south-2"
  }
}
